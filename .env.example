# ============================================================
# CivicPulse Environment Variables Example
# ============================================================
# Copy this file to .env and configure your values:
#   cp .env.example .env (Linux/Mac)
#   Copy-Item .env.example .env (Windows PowerShell)

# ============================================================
# GOOGLE GEMINI AI
# ============================================================
# Get an API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Recommended Gemini models:
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite
GEMINI_STT_MODEL=gemini-2.5-flash

# Confidence thresholds for AI category suggestion (0.0 to 1.0):
AI_AUTO_ACCEPT_THRESHOLD=0.80
AI_REVIEW_THRESHOLD=0.60

# ============================================================
# SECURITY & AUTHENTICATION
# ============================================================
# Change this secret key in production:
SECRET_KEY=change-this-to-a-secure-random-string-in-production

# Cookie settings for session:
# Local development (HTTP):
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Production (HTTPS across different domains, e.g. Vercel frontend + Render backend):
# COOKIE_SECURE=true
# COOKIE_SAMESITE=none

# ============================================================
# CORS (Cross-Origin Resource Sharing)
# ============================================================
# Comma-separated list of allowed frontend URLs:
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ============================================================
# SERVER CONFIGURATION
# ============================================================
HOST=0.0.0.0
PORT=8000
RELOAD=false

# ============================================================
# DATABASE & STORAGE (Supabase / PostgreSQL)
# ============================================================
# SQLite (default for local development if DATABASE_URL is unset):
# SQLITE_DB_PATH=/var/data/civicpulse.db

# ── Supabase Connection Pooler Options ──────────────────────────────────────
#
# Option 1 — SESSION POOLER (port 5432) ← RECOMMENDED for Render web service
#   Use this for persistent, long-running backend processes (e.g. Render Free).
#   Supports psycopg2 persistent connection pooling without PgBouncer
#   transaction-mode restrictions (SET, advisory locks, LISTEN/NOTIFY all work).
#
# DATABASE_URL=postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:5432/postgres?sslmode=require
#
# Option 2 — TRANSACTION POOLER (port 6543) ← for short-lived / serverless use
#   PgBouncer transaction mode — does NOT support SET, advisory locks,
#   persistent sessions, or RETURNING across pool boundaries.
#   Suitable for AWS Lambda, Vercel Functions, or one-shot scripts.
#
# DATABASE_URL=postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
#
# Direct connection (no pooler) — for migrations, seed scripts, pg_dump:
# DATABASE_URL=postgresql://postgres:[db-password]@db.[project-ref].supabase.co:5432/postgres?sslmode=require

# Supabase Storage (Evidence & Photo uploads):
# The storage bucket is PRIVATE — evidence files are civic records and are
# never publicly accessible. The backend generates 1-hour signed URLs via
# GET /complaints/{id}/evidence. The service-role key MUST never be sent to
# the frontend or included in any API response.
# SUPABASE_URL=https://[project-ref].supabase.co
# SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here
# SUPABASE_STORAGE_BUCKET=evidence

# Evidence upload local directory (used when Supabase Storage is not configured):
# UPLOAD_DIR=uploads

# ============================================================
# INITIAL ADMIN SEEDING (Optional)
# ============================================================
# Used by seed_admin.py for non-interactive seeding:
# ADMIN_EMAIL=admin@civicpulse.org
# ADMIN_NAME=Administrator
# ADMIN_PASSWORD=ChangeThisAdminPassword123!
