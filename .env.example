# ============================================================
# CivicPulse Environment Variables Example
# ============================================================
# Copy this file to .env and configure your values:
#   cp .env.example .env (Linux/Mac)
#   Copy-Item .env.example .env (Windows PowerShell)

# ============================================================
# GOOGLE GEMINI AI
# ============================================================
# Get an API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Recommended Gemini models:
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite
GEMINI_STT_MODEL=gemini-2.5-flash

# Confidence thresholds for AI category suggestion (0.0 to 1.0):
AI_AUTO_ACCEPT_THRESHOLD=0.80
AI_REVIEW_THRESHOLD=0.60

# ============================================================
# SECURITY & AUTHENTICATION
# ============================================================
# Change this secret key in production:
SECRET_KEY=change-this-to-a-secure-random-string-in-production

# Cookie settings for session:
# Local development (HTTP):
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Production (HTTPS across different domains, e.g. Vercel frontend + Render backend):
# COOKIE_SECURE=true
# COOKIE_SAMESITE=none

# ============================================================
# CORS (Cross-Origin Resource Sharing)
# ============================================================
# Comma-separated list of allowed frontend URLs:
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ============================================================
# SERVER CONFIGURATION
# ============================================================
HOST=0.0.0.0
PORT=8000
RELOAD=false

# ============================================================
# DATABASE
# ============================================================
# SQLite (default): civicpulse.db in database/ directory
# For custom persistent disk mount (e.g. Render/Docker):
# SQLITE_DB_PATH=/var/data/civicpulse.db

# PostgreSQL (optional):
# DATABASE_URL=postgresql://user:password@localhost:5432/civicpulse

# Evidence upload directory:
# UPLOAD_DIR=uploads

# ============================================================
# INITIAL ADMIN SEEDING (Optional)
# ============================================================
# Used by seed_admin.py for non-interactive seeding:
# ADMIN_EMAIL=admin@civicpulse.org
# ADMIN_NAME=Administrator
# ADMIN_PASSWORD=ChangeThisAdminPassword123!
